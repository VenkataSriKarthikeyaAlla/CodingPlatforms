class Solution {
public:
    int evalRPN(vector<string>& tokens) {
        vector<int>output;
        int top=-1;
        for(int i=0;i<tokens.size();i++)
        {
            if(tokens[i][tokens[i].size()-1]>='0'&&tokens[i][tokens[i].size()-1]<='9')
            {
                int m=1;
                if(tokens[i][0]=='-')
                {
                    m=-1;
                    tokens[i].erase(0,1);
                }
                output.push_back(m*stoi(tokens[i]));
                top++;
            }
            else
            {
                if(top-1<0)
                {
                    return -1;
                }
                switch(tokens[i][0])
                {
                    case '+':
                        output[top-1]=output[top-1]+output[top];
                        output.pop_back();
                        top--;
                        break;
                    case '-':
                        output[top-1]=output[top-1]-output[top];
                        output.pop_back();
                        top--;
                        break;
                    case '*':
                        output[top-1]=output[top-1]*output[top];
                        output.pop_back();
                        top--;
                        break;
                    case '/':
                        output[top-1]=output[top-1]/output[top];
                        output.pop_back();
                        top--;
                        break;
                }
            }
        }
        if(top==0)
        {
            return output[0];
        }
        return -1;
    }
};