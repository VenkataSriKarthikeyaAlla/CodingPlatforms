class Solution {
public:
    bool canPlaceFlowers(vector<int>& flowerbed, int n) {
      int c=0;
      for(int i=0;i<flowerbed.size();i++)
      {
        if(flowerbed[i]==0&&(i-1<0||flowerbed[i-1]==0)&&(i+1>=flowerbed.size()||flowerbed[i+1]==0))
        {
            c++;
            flowerbed[i]=1;
        }
      }  
      if(c>=n)
      {
        return true;
      }
      return false;
    }
};