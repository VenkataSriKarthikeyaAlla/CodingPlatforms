class ProductOfNumbers {
public:
    vector<int>a;
    ProductOfNumbers() {
        
    }
    
    void add(int num) {
        a.push_back(num);
    }
    
    int getProduct(int k) {
        int i=a.size()-1;
        int sum=1;
        while(k)
        {
            sum*=a[i--];
            k--;
        }
        return sum;
    }
};

