class Solution {
public:
    int countConsistent(vector<int>& nums) {
        int c=0;
        for(int i=0;i<nums.size();i++)
        {
            int nd=nums[i],small=nums[i];
            for(int j=i;j<nums.size();j++)
            {
                if(nums[j]<small)
                {
                    small=nums[j];
                }
                nd=nd&nums[j];
                if(small==nd)
                {
                    c++;
                }
            }
        }
        return c;
    }
};