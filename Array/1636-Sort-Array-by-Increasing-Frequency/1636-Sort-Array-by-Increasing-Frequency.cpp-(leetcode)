class Solution {
public:
    vector<int> frequencySort(vector<int>& nums) {
        unordered_map<int,int>a;
        for(int i=0;i<nums.size();i++)
        {
            a[nums[i]]++;
        }
        for(int i=0;i<nums.size();i++)
        {
            for(int j=0;j<nums.size()-1;j++)
            {
                if(a[nums[j]]>a[nums[j+1]])
                {
                    int temp=nums[j];
                    nums[j]=nums[j+1];
                    nums[j+1]=temp;
                }
                if(a[nums[j]]==a[nums[j+1]]&&nums[j]<nums[j+1])
                {
                    int temp=nums[j];
                    nums[j]=nums[j+1];
                    nums[j+1]=temp;
                }
            }
        }
        return nums;
    }
};