class Solution {
public:
    int firstUniqueEven(vector<int>& nums) {
        map<int,int>a;
        for(int i=0;i<nums.size();i++)
        {
            if(nums[i]%2==0)
            {
                a[nums[i]]++;
            }
        }
        for(int i=0;i<nums.size();i++)
        {
            if(nums[i]%2==0&&a[nums[i]]==1)
            {
                return nums[i];
            }
        }
        return -1;
    }
};