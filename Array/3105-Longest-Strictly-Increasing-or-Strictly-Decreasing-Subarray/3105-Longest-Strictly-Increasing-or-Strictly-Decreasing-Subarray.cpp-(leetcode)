class Solution {
public:
    int longestMonotonicSubarray(vector<int>& nums) {
        int b=0,s=0,b1=1,s1=1;
        for(int i=1;i<nums.size();i++)
        {
            if(nums[i]>nums[i-1])
            {
                s1++;
                if(b1>b)
                {
                    b=b1;
                }
                b1=1;
            }
            else if(nums[i]<nums[i-1])
            {
                b1++;
                if(s1>s)
                {
                    s=s1;
                }
                s1=1;
            }
            else
            {
                if(b1>b)
                {
                    b=b1;
                }
                if(s1>s)
                {
                    s=s1;
                }
                b1=s1=1;
            }
        }
        if(b1>b)
        {
            b=b1;
        }
        if(s1>s)
        {
            s=s1;
        }
        return (b>s)?b:s;
    }
};