class Solution {
public:
    vector<int> singleNumber(vector<int>& nums) {
        map<int,int> hs;
        int value=INT_MAX;
        vector<int>a;
        for(int i=0;i<nums.size();i++){
            hs[nums[i]]++;
        }
        for(auto val : hs){
            if(val.second==1){
                a.push_back(val.first);
            }
        }
        return a;
    }
};