class Solution {
public:
    bool uniqueOccurrences(vector<int>& arr) {
        map<int,int>a;
        for(int i=0;i<arr.size();i++)
        {
            a[arr[i]]++;
        }
        set<int>b;
        for(auto i:a)
        {
            b.insert(i.second);
        }
        if(a.size()==b.size())
        {
            return true;
        }
        return false;
    }
};