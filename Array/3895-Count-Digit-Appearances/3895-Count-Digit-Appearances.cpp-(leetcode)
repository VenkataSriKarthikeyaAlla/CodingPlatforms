class Solution {
public:
    int countDigitOccurrences(vector<int>& nums, int digit) {
        int c=0;
        for(int i=0;i<nums.size();i++)
        {
            while(nums[i])
            {
                if(digit==nums[i]%10)
                {
                    c++;
                }
                nums[i]/=10;
            }
        }
        return c;
    }
};