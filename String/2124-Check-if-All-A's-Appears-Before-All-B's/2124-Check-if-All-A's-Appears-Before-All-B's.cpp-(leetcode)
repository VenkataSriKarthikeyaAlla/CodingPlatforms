class Solution {
public:
    bool checkString(string s) {
        bool b=0;
        for(int i=0;i<s.size();i++)
        {
            if(s[i]=='b')
            {
                b=1;
            }
            else if(s[i]=='a')
            {
                if(b==1)
                {
                    return false;
                }
            }
        }
        return true;
    }
};