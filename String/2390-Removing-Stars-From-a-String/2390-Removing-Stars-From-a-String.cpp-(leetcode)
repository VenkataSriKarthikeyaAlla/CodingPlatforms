class Solution {
public:
    string removeStars(string s) {
        string r;
        for(int i=0;i<s.size();i++)
        {
            if(s[i]!='*')
            {
                r.push_back(s[i]);
            }
            else if(r.size()>0)
            {
                r.pop_back();
            }
        }
        return r;
    }
};