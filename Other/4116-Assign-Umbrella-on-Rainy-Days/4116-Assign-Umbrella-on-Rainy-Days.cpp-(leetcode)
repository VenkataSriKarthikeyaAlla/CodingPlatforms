class Solution {
public:
    vector<string> assignUmbrella(vector<int>& rain) {
        int c1=0,c2=0;
        vector<string>ret;
        for(int i=0;i<rain.size();i++)
        {
            if(rain[i]==0)
            {
                ret.push_back("None");
            }
            else
            {
                if(i<rain.size()-1&&rain[i+1]==1)
                {
                    if(c1<=c2)
                    {
                        ret.push_back("Alice");
                        c1++;
                    }
                    else
                    {
                        ret.push_back("Bob");
                        c2++;
                    }
                }
                else
                {
                    ret.push_back("Bob");
                    c2++;
                }
            }
        }
        return ret;
    }
};