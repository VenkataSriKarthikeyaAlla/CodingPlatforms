class Solution {
public:
    int countDominantElements(vector<int>& nums) {
        int c=0;
        if(nums.size()==1||nums[0]>=nums[1])
        {
            c++;
        }
        if(nums.size()>1&&nums[nums.size()-1]>=nums[nums.size()-2])
        {
            c++;
        }
        for(int i=1;i<nums.size()-1;i++)
        {
            if((float)nums[i]>=float((float)(nums[i-1]+nums[i+1])/2))
            {
                c++;
            }
        }
        return c;
    }
};