class Solution {
public:
    int numberOfSpecialChars(string word) {
        unordered_map<char,int>a;
        for(int i=0;i<word.size();i++)
        {
            a[word[i]]++;
        }
        int c=0;
        for(int i=0;i<26;i++)
        {
            if(a['a'+i]>0&&a['A'+i]>0)
            {
                c++;
                a['a'+i]=a['A'+i]=0;
            }
        }
        return c;
    }
};