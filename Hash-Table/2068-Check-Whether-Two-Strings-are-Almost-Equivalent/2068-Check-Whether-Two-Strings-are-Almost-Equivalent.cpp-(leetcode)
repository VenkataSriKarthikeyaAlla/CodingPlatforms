class Solution {
public:
    bool checkAlmostEquivalent(string word1, string word2) {
        map<char,int>a,b;
        for(int i=0;i<word1.size();i++)
        {
            a[word1[i]]++;
        }
        for(int i=0;i<word2.size();i++)
        {
            b[word2[i]]++;
        }
        for(int i=0;i<26;i++)
        {
            int d=abs(a['a'+i]-b['a'+i]);
            if(d>3)
            {
                return false;
            }
        }
        return true;
    }
};